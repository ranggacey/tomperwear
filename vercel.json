{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api/|admin/|static/|favicon\\.ico|manifest\\.json|asset-manifest\\.json|logo).*)",
      "destination": "/index.html"
    }
  ]
}